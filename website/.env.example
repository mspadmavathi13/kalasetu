# NEVER commit your real key to GitHub or put it inside index.html.
BHASHINI_INFERENCE_API_KEY=PASTE_YOUR_BHASHINI_INFERENCE_KEY_HERE

# ASR service is selected automatically by language family in the backend.
# Kannada/Tamil/Telugu → AI4Bharat Dravidian; Hindi/Marathi/Bengali → AI4Bharat Indo-Aryan.
# Existing translation service used by the KalaSetu backend.
BHASHINI_TRANSLATION_SERVICE_ID=ai4bharat/indictrans-v2-all-gpu--t4

PORT=8787
